# Reasoning mode: "mock" (default, deterministic, no external calls) or "gemini".
AGENT_MODE=mock

# Required only when AGENT_MODE=gemini. Get a key from Google AI Studio, or
# use Application Default Credentials with Gemini Enterprise / Vertex AI in
# a later iteration. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Used only for documentation/labels in the deployed demo; not required to run locally.
GOOGLE_CLOUD_PROJECT=

# Cloud Run injects PORT automatically; only needed for local overrides.
PORT=8080
